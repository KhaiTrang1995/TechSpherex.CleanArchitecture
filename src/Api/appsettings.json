{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Elasticsearch"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "TechSpherex.CleanArchitecture.Infrastructure.Tenancy": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Elasticsearch",
        "Args": {
          "nodeUris": "http://localhost:9200",
          "indexFormat": "techspherex-logs-{0:yyyy.MM.dd}",
          "autoRegisterTemplate": true,
          "autoRegisterTemplateVersion": "ESv8",
          "numberOfShards": 1,
          "numberOfReplicas": 0
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "TechSpherex.CleanArchitecture.Api"
    }
  },
  "Jwt": {
    "Secret": "CHANGE-THIS-TO-A-SECURE-SECRET-KEY-AT-LEAST-32-CHARS",
    "Issuer": "TechSpherex.CleanArchitecture",
    "Audience": "TechSpherex.CleanArchitecture",
    "ExpirationInMinutes": "60",
    "RefreshTokenExpirationInDays": "7"
  },
  "MultiTenancy": {
    "Enabled": true,
    "DefaultTenantId": "default",
    "HeaderName": "X-Tenant-Id"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173", "https://techspherex.com" ],
    "AllowedMethods": [ "GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS" ],
    "AllowedHeaders": [ "*" ],
    "AllowCredentials": true
  },
  "Caching": {
    "DefaultExpirationMinutes": 5,
    "LocalExpirationMinutes": 2,
    "Comment": "L1 = In-Memory (RAM), L2 = Redis (Aspire-managed). HybridCache auto-falls through: RAM → Redis → Factory."
  },
  "RuleEngine": {
    "RuleSets": {
      "TodoCreation": {
        "Operator": "And",
        "Rules": [
          {
            "Code": "Todo.TitleRequired",
            "Field": "Title",
            "Operator": "IsNotNull",
            "Message": "Todo title is required.",
            "Priority": 1
          },
          {
            "Code": "Todo.TitleMinLength",
            "Field": "TitleLength",
            "Operator": ">=",
            "Value": "3",
            "Message": "Todo title must be at least 3 characters.",
            "Priority": 2
          },
          {
            "Code": "Todo.TitleMaxLength",
            "Field": "TitleLength",
            "Operator": "<=",
            "Value": "200",
            "Message": "Todo title must not exceed 200 characters.",
            "Priority": 3
          }
        ]
      },
      "OrderApproval": {
        "Operator": "And",
        "Rules": [
          {
            "Code": "Order.MinAmount",
            "Field": "Amount",
            "Operator": ">=",
            "Value": "1",
            "Message": "Order amount must be at least 1.",
            "Priority": 1
          },
          {
            "Code": "Order.MaxAmount",
            "Field": "Amount",
            "Operator": "<=",
            "Value": "100000",
            "Message": "Order amount must not exceed 100,000.",
            "Priority": 2
          }
        ]
      }
    }
  },
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http1AndHttp2"
    }
  }
}